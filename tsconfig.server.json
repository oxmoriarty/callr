{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "outDir": "./dist-server",
    "noEmit": false,
    "incremental": false
  },
  "include": [
    "server.ts",
    "server/**/*.ts",
    "lib/**/*.ts",
    "jobs/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "app",
    "components",
    "hooks",
    "tests",
    "target",
    "programs"
  ]
}
