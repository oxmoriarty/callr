{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/sync-fixtures",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/settlement",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "app/api/settlement/route.ts": { "maxDuration": 60 },
    "app/api/cron/sync-fixtures/route.ts": { "maxDuration": 30 }
  }
}
